{
  "name": "packer-learning",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "AMI Board",
      "onAutoForward": "notify"
    }
  },

  // Mount your local AWS credentials read-only so `packer build` can
  // authenticate without baking keys into the image or env vars.
  // "mounts": [
  //   "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly"
  // ],

  "containerEnv": {
    "AWS_PROFILE": "packer-learning"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.hcl",
        "hashicorp.terraform",
        "amazonwebservices.aws-toolkit-vscode",
        "timonwong.shellcheck",
        "ms-python.python"
      ],
      "settings": {
        "files.associations": {
          "*.pkr.hcl": "hcl",
          "*.pkrvars.hcl": "hcl"
        }
      }
    }
  },

  "postCreateCommand": "packer version && aws --version && pip3 install --no-cache-dir -r ami-dashboard/backend/requirements.txt",

  "remoteUser": "vscode"
}